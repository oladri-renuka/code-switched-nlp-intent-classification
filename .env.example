# Reddit API Configuration
# Get credentials from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=code-switched-nlp-collector/1.0

# Anthropic API (for LLM annotation)
ANTHROPIC_API_KEY=your_api_key_here

# W&B Integration (optional)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=code-switched-nlp

# Model Configuration
HF_TOKEN=your_huggingface_token_here  # For downloading models

# Deployment
DEPLOYMENT_ENV=development  # or production
DEBUG=true
